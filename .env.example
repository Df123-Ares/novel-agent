OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b
# thinking models must disable thinking for clean structured JSON output
OLLAMA_THINK=false
CONTEXT_LIMIT=32768
OUTPUT_RESERVE_TOKENS=2048
DEFAULT_NUM_PREDICT=2048
SCHEMA_REPAIR_RETRIES=2
DATABASE_URL=sqlite:///data/novel_agent.db
WORDS_SHORT=30000
WORDS_MEDIUM=120000
WORDS_LONG=300000
PREV_CHAPTER_TAIL_CHARS=1500
MAX_FACTS_IN_CONTEXT=50
WRITER_NUM_PREDICT_FLOOR=4096
WRITER_NUM_PREDICT_CEIL=12288
WRITER_MIN_WORDS_RATIO=0.55
WRITER_REPAIR_REPETITION=true
WRITER_MAX_REPAIR=2
WRITER_MAX_TRIM_RATIO=0.25
WRITER_ENFORCE_QUALITY_ON_CONFIRM=true
