# ── Ollama 连接 ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# thinking models must disable thinking for clean structured JSON output
OLLAMA_THINK=false

# ── GPU / 推理加速 ──────────────────────────────────────────────────────────
# GPU 层数：-1=全部（推荐），0=纯 CPU，否则指定具体层数。
# qwen2.5-7b 共 28 层 Q4 ≈ 4.7GB，6GB VRAM 刚好塞下；
# 若频繁 swap/OOM → 降为 26-27 层留 200-400MB 缓冲；
# 若要跑更大模型（如 14b 部分上 GPU）→ 设为 10-20 看显存。
OLLAMA_NUM_GPU=-1

# ── 上下文 / 输出预算 ──────────────────────────────────────────────────────
# num_ctx for every ollama call. 6144 covers observed prompt+output sizes on
# this 6GB VRAM box without the 4096-default silent prompt truncation.
CONTEXT_LIMIT=6144
DEFAULT_NUM_PREDICT=2048
# schema 修复重试次数：1 次已足够，2 次会让单章耗时翻倍。
SCHEMA_REPAIR_RETRIES=1

# ── 采样参数（速度 + 质量双控）───────────────────────────────────────────────
# 温度：越低越稳定/越快（发散少→扩写/重写少），但过低词汇贫乏。
# 网文写作 0.65-0.7 是平衡点；需要多样性→0.75，追求稳定→0.60。
TEMPERATURE=0.65
# 候选词控制（Ollama 默认 top_k=40, top_p=0.9）。
TOP_K=40
TOP_P=0.9
# TFS (Tail Free Sampling)：削除低概率长尾，减少无效计算。
# 0.95 温和提速 5%+；进一步加速→0.90；0=禁用。
TFS_Z=0.95
# min_p 相对概率阈值：候选词概率 < max_prob*min_p 则丢弃。
# 0.05 砍 <2% 概率的候选，对质量影响小但可 5-10% 提速；0=禁用。
MIN_P=0.05
# 重复惩罚窗口：Ollama 默认 64 对长文太短，跨段重复逃过惩罚。
# 建议 512-1024；-1=整个上下文（会略微拖慢，但抑制退化最彻底）。
REPEAT_LAST_N=512
# 重复惩罚：默认 1.1，1.18 抑制中文长文退化循环；
# 过高 1.25+ 会导致词汇贫乏；配合 REPEAT_LAST_N=512 更佳。
REPEAT_PENALTY=1.18
# Mirostat 动态 perplexity 控制（长文特别有用）：
#   0=关闭（Ollama 默认），1=v1，2=v2（推荐）
# 开启后会动态调整采样熵，避免长文中段质量断崖，速度影响可忽略。
OLLAMA_MIROSTAT=2
# mirostat_tau 目标熵值：更小→更确定，更大→更发散。7b+0.65temp 推荐 4.0。
OLLAMA_MIROSTAT_TAU=4.0

# ── 数据库 / 字数规划 ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/novel_agent.db
WORDS_SHORT=30000
WORDS_MEDIUM=120000
WORDS_LONG=300000

# ── 写作流水线调优 ──────────────────────────────────────────────────────────
# 上一章回溯字符数（压缩以腾出输出上下文）
PREV_CHAPTER_TAIL_CHARS=800
# 跨章禁用表达清单条数：从最近 3 章已确认正文抽取高频短语注入下一章提示词，0=关闭；推荐 5-10。
BANNED_PHRASES_PER_CHAPTER=5
# 短语在最近 3 章正文中出现达到该次数才纳入禁用清单
BANNED_PHRASE_MIN_HITS=3

# 上下文注入最大事实条数（RAG 已启用，30-50 之间合适）
MAX_FACTS_IN_CONTEXT=50
# 写作最小 token 预算（3072 足以覆盖 2000 字目标；ctx 不足时由代码自动收缩）
WRITER_NUM_PREDICT_FLOOR=3072
WRITER_NUM_PREDICT_CEIL=12288
WRITER_MIN_WORDS_RATIO=0.5
WRITER_REPAIR_REPETITION=true
# 重写轮数：0 关闭（每次重写都是 1 次 4096 tokens 慢调用）；
# 重复问题已在采样端通过 repeat_penalty/top_k/top_p/repeat_last_n 抑制。
WRITER_MAX_REPAIR=0
WRITER_MAX_TRIM_RATIO=0.25
WRITER_ENFORCE_QUALITY_ON_CONFIRM=true
# 单章目标字数上限（6GB 显存约束，超出自动拆章）
MAX_CHAPTER_WORDS=2000
# 章节生成时的一致性校验开关（默认关闭以提速，润色时始终执行）
RUN_CONSISTENCY_CHECK=false
# 候选事实抽取开关（默认关闭以提速；每章节省 1 次 LLM 调用；
# 开启 RUN_CONSISTENCY_CHECK 时建议同时开启）
RUN_EXTRACTOR=false

# ── 分层摘要（长篇一致性核心机制）─────────────────────────────────────────
# 每 ARC_SIZE 章（默认 10）生成一卷摘要，注入到后续章节的写作上下文。
# 解决长篇剧情遗忘：第 50 章能看到第 1-10、11-20、21-30、31-40 卷的摘要。
# 每 MEGA_ARC_SIZE 章（默认 50）生成"大卷摘要"，进一步压缩 5 个卷摘要。
ARC_SIZE=10
MEGA_ARC_SIZE=50
# 注入到 chapter_context 的最近卷摘要数（默认 5 = 最近 50 章）。
# 设为 0 关闭分层摘要注入；过大可能撑爆 ctx。
ARC_SUMMARIES_IN_CONTEXT=5
# 注入的最近大卷摘要数（默认 3 = 最近 150 章）；超过此数取最近的。
MEGA_ARC_SUMMARIES_IN_CONTEXT=3
# 卷摘要生成时的 num_predict 上限（约 800 字 ≈ 1200 tokens）。
ARC_SUMMARY_NUM_PREDICT=1200
